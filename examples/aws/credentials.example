; ~/.aws/credentials 예시
;
; cloudloupe는 이 파일을 어떤 프로필 이름이 존재하는지 파악하기 위해서만 읽습니다.
; 비밀값은 AWS SDK 자격증명 체인이 해석하고, 프로세스가 살아 있는 동안만 메모리에 있으며,
; 스냅샷 캐시나 리포트에 절대 기록되지 않습니다.
;
; 실제 credentials 파일은 절대 커밋하지 마세요. 장기 액세스 키보다 IAM Identity Center(SSO)나
; assume-role을 권장합니다. config.example을 참고하세요.

[default]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

; 임시 자격증명에는 세션 토큰도 함께 들어갑니다.
[temporary-session]
aws_access_key_id = ASIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
aws_session_token = IQoJb3JpZ2luX2VjEXAMPLETOKENDOESNOTWORK
