{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowInvestigatorAccountToAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:role/cloudloupe-investigator"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "StringEquals": {
          "sts:ExternalId": "REPLACE-WITH-A-RANDOM-EXTERNAL-ID"
        }
      }
    }
  ]
}
